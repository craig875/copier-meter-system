# Backend origin (no /api suffix). Axios uses `${VITE_API_URL}/api`.
#
# Local: copy to .env.local (gitignored) and run `npm run dev` in frontend/.
#   VITE_API_URL=http://localhost:3001
#
# If VITE_API_URL is unset, axios uses same-origin `/api` (Vite proxies to localhost:3001).
#
# Production build: set this to the public API origin when the SPA is hosted separately.
#   VITE_API_URL=https://your-backend-url.example.com
