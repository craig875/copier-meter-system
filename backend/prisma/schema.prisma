// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Legacy enum role (kept for dual-run). DB type name remains "Role".
enum UserRole {
  admin
  manager
  user
  management
  meter_user
  sales_agent
  capturer
  viewer

  @@map("Role")
}

enum Branch {
  JHB
  CT
}

enum PermissionEffect {
  GRANT
  DENY
}

/// Editable / system roles for the permission redesign (Stage A+).
model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isImmutable Boolean  @default(false) @map("is_immutable")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id")
  permissionKey String @map("permission_key")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  permissionKey String           @map("permission_key")
  effect        PermissionEffect
  grantedBy     String?          @map("granted_by")
  note          String?
  createdAt     DateTime         @default(now()) @map("created_at")

  user          User  @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("UserPermissionOverrideGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, permissionKey])
  @@index([permissionKey])
  @@map("user_permission_overrides")
}

model User {
  id                                      String                          @id @default(uuid())
  email                                   String                          @unique
  passwordHash                            String                          @map("password_hash")
  name                                    String
  /// Legacy enum role — still authoritative for enforcement in Stage A
  role                                    UserRole                        @default(meter_user)
  /// New role FK — seeded in Stage A; not enforced yet
  roleId                                  String                          @map("role_id")
  branch                                  Branch
  /// Feature modules this user may access: copiers, connectivity, fibre-orders, installations, crm
  modules                                 String[]                        @default([])
  twoFactorSecret                         String?                         @map("two_factor_secret")
  twoFactorEnabled                        Boolean                         @default(false) @map("two_factor_enabled")
  createdAt                               DateTime                        @default(now()) @map("created_at")
  updatedAt                               DateTime                        @updatedAt @map("updated_at")
  readings                                Reading[]
  unableToReadOverrides                   Reading[]                       @relation("UnableToReadOverrideBy")
  unableToObtainOverrideRequestsRequested UnableToObtainOverrideRequest[] @relation("UnableToObtainOverrideRequestedBy")
  unableToObtainOverrideRequestsResolved  UnableToObtainOverrideRequest[] @relation("UnableToObtainOverrideResolvedBy")
  submissions                             Submission[]
  auditLogs                               AuditLog[]
  partReplacements                        PartReplacement[]
  notifications                           Notification[]

  installationProjectsCreated  InstallationProject[]           @relation("InstallationProjectCreatedBy")
  installationProjectStepsDone InstallationProjectStep[]
  installationAssignments      InstallationProjectAssignment[]

  fibreOrdersAsSalesAgent     FibreOrder[]              @relation("FibreOrderSalesAgent")
  fibreOrdersCreated          FibreOrder[]              @relation("FibreOrderCreatedBy")
  orderUpdates                OrderUpdate[]
  fibreUpdateRequests         FibreOrderUpdateRequest[] @relation("FibreUpdateRequestRequestedBy")
  fibreUpdateRequestsResolved FibreOrderUpdateRequest[] @relation("FibreUpdateRequestResolvedBy")

  branchAccess        UserBranchAccess[]
  branchAccessGranted UserBranchAccess[] @relation("UserBranchAccessGrantedBy")

  assignedRole               Role                     @relation(fields: [roleId], references: [id])
  permissionOverrides        UserPermissionOverride[] @relation("UserPermissionOverrides")
  permissionOverridesGranted UserPermissionOverride[] @relation("UserPermissionOverrideGrantedBy")
  permissionShadowLogs       PermissionShadowLog[]

  installsCreated         Install[]         @relation("InstallCreatedBy")
  installUpdatesCreated   InstallUpdate[]   @relation("InstallUpdateCreatedBy")
  installDocumentsCreated InstallDocument[] @relation("InstallDocumentCreatedBy")
  installTasksAssigned    InstallTask[]     @relation("InstallTaskAssignee")
  installTasksCreated     InstallTask[]     @relation("InstallTaskCreatedBy")
  appSettingsUpdated      AppSetting[]      @relation("AppSettingUpdatedBy")

  accountsManaged      Customer[]    @relation("CustomerAccountManager")
  dealsOwned           Deal[]        @relation("DealOwner")
  crmActivitiesLogged  CrmActivity[] @relation("CrmActivityLogger")
  crmTasksAssigned     CrmTask[]     @relation("CrmTaskAssignee")

  @@map("users")
}

enum CrmStatus {
  prospect
  active
  dormant
  churned
}

enum DealStage {
  lead
  qualified
  proposal
  negotiation
  won
  lost
}

enum CrmActivityType {
  call
  email
  meeting
  note
}

enum CrmTaskStatus {
  pending
  done
}

enum CrmTaskPriority {
  low
  medium
  high
}

model Contact {
  id          String    @id @default(uuid())
  customerId  String    @map("customer_id")
  customer    Customer  @relation(fields: [customerId], references: [id])
  name        String
  role        String?
  email       String?
  phone       String?
  isPrimary   Boolean   @default(false) @map("is_primary")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  deals       Deal[]
  activities  CrmActivity[]

  @@index([customerId])
  @@map("contacts")
}

model Deal {
  id                String     @id @default(uuid())
  customerId        String     @map("customer_id")
  customer          Customer   @relation(fields: [customerId], references: [id])
  contactId         String?    @map("contact_id")
  contact           Contact?   @relation(fields: [contactId], references: [id])
  ownerId           String     @map("owner_id")
  owner             User       @relation("DealOwner", fields: [ownerId], references: [id])
  title             String
  stage             DealStage  @default(lead)
  value             Decimal?   @db.Decimal(12, 2)
  currency          String     @default("ZAR")
  expectedCloseDate DateTime?  @map("expected_close_date")
  actualCloseDate   DateTime?  @map("actual_close_date")
  lostReason        String?    @map("lost_reason")
  source            String?
  branch            Branch
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  activities        CrmActivity[]
  crmTasks          CrmTask[]

  @@index([customerId])
  @@index([ownerId])
  @@index([branch])
  @@map("deals")
}

model CrmActivity {
  id           String          @id @default(uuid())
  type         CrmActivityType
  customerId   String          @map("customer_id")
  customer     Customer        @relation(fields: [customerId], references: [id])
  contactId    String?         @map("contact_id")
  contact      Contact?        @relation(fields: [contactId], references: [id])
  dealId       String?         @map("deal_id")
  deal         Deal?           @relation(fields: [dealId], references: [id])
  userId       String          @map("user_id")
  user         User            @relation("CrmActivityLogger", fields: [userId], references: [id])
  subject      String
  body         String?
  activityDate DateTime        @default(now()) @map("activity_date")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([customerId])
  @@index([dealId])
  @@map("crm_activities")
}

model CrmTask {
  id           String          @id @default(uuid())
  title        String
  description  String?
  dueDate      DateTime?       @map("due_date")
  status       CrmTaskStatus   @default(pending)
  priority     CrmTaskPriority @default(medium)
  assignedToId String          @map("assigned_to_id")
  assignedTo   User            @relation("CrmTaskAssignee", fields: [assignedToId], references: [id])
  customerId   String?         @map("customer_id")
  customer     Customer?       @relation(fields: [customerId], references: [id])
  dealId       String?         @map("deal_id")
  deal         Deal?           @relation(fields: [dealId], references: [id])
  createdAt    DateTime        @default(now()) @map("created_at")
  completedAt  DateTime?       @map("completed_at")

  @@index([assignedToId])
  @@index([customerId])
  @@map("crm_tasks")
}

/// Stage C: mismatch log between legacy role gates and effective permissions (observe-only).
model PermissionShadowLog {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  route         String
  permissionKey String   @map("permission_key")
  oldAllowed    Boolean  @map("old_allowed")
  newAllowed    Boolean  @map("new_allowed")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
  @@index([permissionKey])
  @@map("permission_shadow_log")
}

/// Which branches a user may access (Stage 6a). Active branch selection is enforced in later stages.
model UserBranchAccess {
  userId    String   @map("user_id")
  branch    Branch
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by")

  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("UserBranchAccessGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@id([userId, branch])
  @@map("user_branch_access")
}

enum InstallationDuty {
  PROJECT_LEAD
  TECHNICIAN
  SALES
  CONNECTIVITY_SPECIALIST
}

enum InstallationProjectStatus {
  draft
  in_progress
  completed
  cancelled
}

enum InstallationProjectStepStatus {
  pending
  in_progress
  completed
  skipped
}

model InstallationType {
  id          String   @id @default(uuid())
  code        String   @unique @map("code")
  name        String   @map("name")
  description String?  @map("description")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  steps    InstallationTypeStep[]
  projects InstallationProject[]

  @@map("installation_types")
}

model InstallationTypeStep {
  id          String           @id @default(uuid())
  typeId      String           @map("type_id")
  sortOrder   Int              @map("sort_order")
  title       String           @map("title")
  description String?          @map("description")
  duty        InstallationDuty @map("duty")
  isBlocking  Boolean          @default(true) @map("is_blocking")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  type            InstallationType          @relation(fields: [typeId], references: [id], onDelete: Cascade)
  projectStepRefs InstallationProjectStep[]

  @@index([typeId])
  @@map("installation_type_steps")
}

model InstallationProject {
  id           String                    @id @default(uuid())
  typeId       String                    @map("type_id")
  customerName String?                   @map("customer_name")
  siteLabel    String?                   @map("site_label")
  notes        String?                   @map("notes")
  status       InstallationProjectStatus @default(draft) @map("status")
  plannedStart DateTime?                 @map("planned_start")
  plannedEnd   DateTime?                 @map("planned_end")
  createdById  String                    @map("created_by")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  type        InstallationType                @relation(fields: [typeId], references: [id], onDelete: Restrict)
  createdBy   User                            @relation("InstallationProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  steps       InstallationProjectStep[]
  assignments InstallationProjectAssignment[]

  @@index([typeId])
  @@index([status])
  @@index([createdById])
  @@map("installation_projects")
}

model InstallationProjectStep {
  id             String                        @id @default(uuid())
  projectId      String                        @map("project_id")
  templateStepId String?                       @map("template_step_id")
  sortOrder      Int                           @map("sort_order")
  title          String                        @map("title")
  description    String?                       @map("description")
  duty           InstallationDuty              @map("duty")
  isBlocking     Boolean                       @default(true) @map("is_blocking")
  status         InstallationProjectStepStatus @default(pending) @map("status")
  completedById  String?                       @map("completed_by")
  completedAt    DateTime?                     @map("completed_at")
  note           String?                       @map("note")
  createdAt      DateTime                      @default(now()) @map("created_at")
  updatedAt      DateTime                      @updatedAt @map("updated_at")

  project      InstallationProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateStep InstallationTypeStep? @relation(fields: [templateStepId], references: [id], onDelete: SetNull)
  completedBy  User?                 @relation(fields: [completedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("installation_project_steps")
}

model InstallationProjectAssignment {
  id        String           @id @default(uuid())
  projectId String           @map("project_id")
  duty      InstallationDuty @map("duty")
  userId    String           @map("user_id")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  project InstallationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, duty])
  @@index([userId])
  @@map("installation_project_assignments")
}

// =============================================================================
// Installations tracker (fresh build — not related to InstallationProject above)
// =============================================================================

enum InstallStatus {
  active
  complete
  on_hold
  cancelled
}

enum InstallDocumentKind {
  LINK
  FILE
}

enum InstallTaskStatus {
  assigned
  acknowledged
  complete
}

/// Hardware kind catalog for Installations (copier, fibre gear, other).
model InstallType {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  installs Install[]

  @@map("install_types")
}

/// One installation job (UI: Installations).
model Install {
  id                     String        @id @default(uuid())
  branch                 Branch
  typeId                 String?       @map("type_id")
  /// Free-text install type label (UI: Type). Catalog InstallType remains optional legacy FK.
  typeName               String?       @map("type_name")
  customerName           String        @map("customer_name")
  siteName               String?       @map("site_name")
  /// Free-text geographic area (suburb / region), not a fixed list.
  area                   String?
  siteAddress            String?       @map("site_address")
  /// Optional site contact (free-text; no phone format validation).
  contactPersonName      String?       @map("contact_person_name")
  contactPersonPhone     String?       @map("contact_person_phone")
  salesOrderNumber       String?       @map("sales_order_number")
  status                 InstallStatus @default(active)
  /// Free-text current progress (e.g. "awaiting stock").
  progress               String?
  scheduledDate          DateTime?     @map("scheduled_date") @db.Date
  completedDate          DateTime?     @map("completed_date") @db.Date
  assignedTechnicianName String?       @map("assigned_technician_name")
  notes                  String?
  createdById            String        @map("created_by")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  type      InstallType?      @relation(fields: [typeId], references: [id], onDelete: Restrict)
  createdBy User              @relation("InstallCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updates   InstallUpdate[]
  documents InstallDocument[]
  tasks     InstallTask[]

  @@index([branch])
  @@index([status])
  @@index([typeId])
  @@index([createdById])
  @@map("installs")
}

/// Sub-task on an installation, assigned to a real User.
model InstallTask {
  id             String            @id @default(uuid())
  installId      String            @map("install_id")
  title          String
  description    String?
  assignedToId   String            @map("assigned_to_id")
  status         InstallTaskStatus @default(assigned)
  createdById    String            @map("created_by_id")
  acknowledgedAt DateTime?         @map("acknowledged_at")
  completedAt    DateTime?         @map("completed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  install    Install @relation(fields: [installId], references: [id], onDelete: Cascade)
  assignedTo User    @relation("InstallTaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy  User    @relation("InstallTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([installId])
  @@index([assignedToId])
  @@index([status])
  @@map("install_tasks")
}

/// Timeline of status / progress changes.
model InstallUpdate {
  id               String         @id @default(uuid())
  installId        String         @map("install_id")
  previousStatus   InstallStatus? @map("previous_status")
  newStatus        InstallStatus? @map("new_status")
  previousProgress String?        @map("previous_progress")
  newProgress      String?        @map("new_progress")
  note             String?
  createdById      String         @map("created_by")
  createdAt        DateTime       @default(now()) @map("created_at")

  install   Install @relation(fields: [installId], references: [id], onDelete: Cascade)
  createdBy User    @relation("InstallUpdateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([installId])
  @@index([createdAt])
  @@map("install_updates")
}

/// Documents for an install (LINK now; FILE later).
model InstallDocument {
  id          String              @id @default(uuid())
  installId   String              @map("install_id")
  kind        InstallDocumentKind @default(LINK)
  label       String?
  url         String?
  storageKey  String?             @map("storage_key")
  fileName    String?             @map("file_name")
  contentType String?             @map("content_type")
  byteSize    Int?                @map("byte_size")
  createdById String              @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")

  install   Install @relation(fields: [installId], references: [id], onDelete: Cascade)
  createdBy User    @relation("InstallDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([installId])
  @@map("install_documents")
}

/// Key/value app configuration (e.g. sales-order URL template).
model AppSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by")

  updatedBy User? @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

enum FibrePipelineStatus {
  order_placed
  awaiting_cx_number
  awaiting_site_survey_scheduling
  site_survey_scheduled
  site_survey_complete
  planning_documents_unsigned
  planning_documents_signed
  wayleave_pending
  wayleave_approved
  awaiting_installation_date
  installation_date_received
  installation_in_progress
  installation_complete
  awaiting_fno_cpe_installation
  awaiting_atc_testing_date
  atc_testing_complete
  awaiting_handover
  handover_received
  awaiting_cutover
  complete
}

enum FibreOverlayStatus {
  wip
  on_hold
  cancelled
}

model FibreProduct {
  id              String   @id @default(uuid())
  name            String   @map("name")
  productType     String   @map("product_type")
  defaultEtaWeeks Int      @map("default_eta_weeks")
  notes           String?  @map("notes")
  isActive        Boolean  @default(true) @map("is_active")
  branch          Branch   @map("branch")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orders FibreOrder[]

  @@unique([name, branch])
  @@index([branch])
  @@map("fibre_products")
}

model FibreOrder {
  id                  String              @id @default(uuid())
  branch              Branch              @default(JHB) @map("branch")
  customerName        String              @map("customer_name")
  customerReference   String?             @map("customer_reference")
  installationAddress String              @map("installation_address")
  productId           String              @map("product_id")
  salesAgentId        String              @map("sales_agent_id")
  orderPlacementDate  DateTime            @map("order_placement_date") @db.Date
  expectedInstallDate DateTime            @map("expected_install_date") @db.Date
  pipelineStatus      FibrePipelineStatus @default(order_placed) @map("pipeline_status")
  overlayStatus       FibreOverlayStatus? @map("overlay_status")
  notes               String?             @map("notes")
  createdById         String              @map("created_by")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  product        FibreProduct              @relation(fields: [productId], references: [id], onDelete: Restrict)
  salesAgent     User                      @relation("FibreOrderSalesAgent", fields: [salesAgentId], references: [id], onDelete: Restrict)
  createdBy      User                      @relation("FibreOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updates        OrderUpdate[]
  updateRequests FibreOrderUpdateRequest[]

  @@index([branch])
  @@index([pipelineStatus])
  @@index([overlayStatus])
  @@index([salesAgentId])
  @@index([orderPlacementDate])
  @@map("fibre_orders")
}

model OrderUpdate {
  id                     String               @id @default(uuid())
  orderId                String               @map("order_id")
  previousPipelineStatus FibrePipelineStatus? @map("previous_pipeline_status")
  newPipelineStatus      FibrePipelineStatus? @map("new_pipeline_status")
  previousOverlayStatus  FibreOverlayStatus?  @map("previous_overlay_status")
  newOverlayStatus       FibreOverlayStatus?  @map("new_overlay_status")
  note                   String?              @map("note")
  updatedById            String               @map("updated_by")
  createdAt              DateTime             @default(now()) @map("created_at")

  order     FibreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  updatedBy User       @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_updates")
}

enum FibreUpdateRequestStatus {
  pending
  resolved
}

model FibreOrderUpdateRequest {
  id            String                   @id @default(uuid())
  orderId       String                   @map("order_id")
  requestedById String                   @map("requested_by_id")
  note          String?                  @map("note")
  status        FibreUpdateRequestStatus @default(pending) @map("status")
  resolvedAt    DateTime?                @map("resolved_at")
  resolvedById  String?                  @map("resolved_by_id")
  createdAt     DateTime                 @default(now()) @map("created_at")

  order       FibreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("FibreUpdateRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  resolvedBy  User?      @relation("FibreUpdateRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([status, createdAt])
  @@map("fibre_order_update_requests")
}

enum PartType {
  general
  toner
}

enum TonerColor {
  black
  cyan
  magenta
  yellow
}

enum MeterType {
  mono
  colour
  total
}

model Customer {
  id          String   @id @default(uuid())
  name        String   @map("name")
  contactName String?  @map("contact_name")
  email       String?  @map("email")
  phone       String?  @map("phone")
  address     String?  @map("address")
  branch      Branch   @map("branch")
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  machines Machine[]

    accountManagerId String?      @map("account_manager_id")
  accountManager   User?        @relation("CustomerAccountManager", fields: [accountManagerId], references: [id])
  crmStatus        CrmStatus    @default(prospect) @map("crm_status")
  source           String?      @map("source")
  industry         String?      @map("industry")

  contacts         Contact[]
  deals            Deal[]
  activities       CrmActivity[]
  crmTasks         CrmTask[]

  @@index([name])
  @@index([branch])
  @@map("customers")
}

model Make {
  id     String @id @default(uuid())
  name   String @map("name")
  branch Branch @map("branch")

  models Model[]

  @@unique([name, branch])
  @@index([branch])
  @@map("makes")
}

enum PaperSize {
  A3
  A4
}

enum ModelType {
  mono
  colour
}

model Model {
  id          String    @id @default(uuid())
  makeId      String    @map("make_id")
  name        String    @map("name")
  paperSize   PaperSize @default(A4) @map("paper_size")
  modelType   ModelType @default(mono) @map("model_type")
  machineLife Int?      @map("machine_life")
  branch      Branch    @map("branch")

  make       Make        @relation(fields: [makeId], references: [id], onDelete: Restrict)
  machines   Machine[]
  modelParts ModelPart[]

  @@unique([makeId, name])
  @@index([makeId])
  @@index([branch])
  @@map("models")
}

model Machine {
  id                             String                          @id @default(uuid())
  machineSerialNumber            String                          @unique @map("machine_serial_number")
  modelId                        String?                         @map("model_id")
  customerId                     String?                         @map("customer_id")
  location                       String?                         @map("location")
  contractReference              String?                         @map("contract_reference")
  monoEnabled                    Boolean                         @default(true) @map("mono_enabled")
  colourEnabled                  Boolean                         @default(false) @map("colour_enabled")
  scanEnabled                    Boolean                         @default(false) @map("scan_enabled")
  isActive                       Boolean                         @default(true) @map("is_active")
  isDecommissioned               Boolean                         @default(false) @map("is_decommissioned")
  branch                         Branch                          @default(JHB)
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  model                          Model?                          @relation(fields: [modelId], references: [id], onDelete: SetNull)
  customer                       Customer?                       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  readings                       Reading[]
  partReplacements               PartReplacement[]
  unableToObtainOverrideRequests UnableToObtainOverrideRequest[]

  @@index([contractReference])
  @@index([modelId])
  @@index([customerId])
  @@index([branch])
  @@map("machines")
}

enum UnableToObtainOverrideRequestStatus {
  pending
  resolved
}

model UnableToObtainOverrideRequest {
  id            String                              @id @default(uuid())
  machineId     String                              @map("machine_id")
  year          Int
  month         Int
  branch        Branch                              @default(JHB)
  requestedById String                              @map("requested_by_id")
  note          String?
  status        UnableToObtainOverrideRequestStatus @default(pending)
  resolvedAt    DateTime?                           @map("resolved_at")
  resolvedById  String?                             @map("resolved_by_id")
  createdAt     DateTime                            @default(now()) @map("created_at")

  machine     Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("UnableToObtainOverrideRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  resolvedBy  User?   @relation("UnableToObtainOverrideResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([machineId, year, month])
  @@index([status, createdAt])
  @@index([branch, status])
  @@map("unable_to_obtain_override_requests")
}

model Reading {
  id                         String    @id @default(uuid())
  machineId                  String    @map("machine_id")
  year                       Int
  month                      Int
  monoReading                Int?      @map("mono_reading")
  colourReading              Int?      @map("colour_reading")
  scanReading                Int?      @map("scan_reading")
  monoUsage                  Int?      @map("mono_usage")
  colourUsage                Int?      @map("colour_usage")
  scanUsage                  Int?      @map("scan_usage")
  note                       String?   @map("note")
  unableToRead               Boolean   @default(false) @map("unable_to_read")
  unableToReadReason         String?   @map("unable_to_read_reason")
  unableToReadOverride       Boolean   @default(false) @map("unable_to_read_override")
  unableToReadOverrideReason String?   @map("unable_to_read_override_reason")
  unableToReadOverrideBy     String?   @map("unable_to_read_override_by")
  unableToReadOverrideAt     DateTime? @map("unable_to_read_override_at")
  monoUnchangedReason        String?   @map("mono_unchanged_reason")
  colourUnchangedReason      String?   @map("colour_unchanged_reason")
  scanUnchangedReason        String?   @map("scan_unchanged_reason")
  branch                     Branch    @default(JHB)
  capturedBy                 String    @map("captured_by")
  capturedAt                 DateTime  @default(now()) @map("captured_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  machine                  Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user                     User    @relation(fields: [capturedBy], references: [id])
  unableToReadOverrideUser User?   @relation("UnableToReadOverrideBy", fields: [unableToReadOverrideBy], references: [id], onDelete: SetNull)

  @@unique([machineId, year, month])
  @@index([machineId])
  @@index([year, month])
  @@index([branch])
  @@index([unableToReadOverrideBy])
  @@map("readings")
}

model Submission {
  id          String   @id @default(uuid())
  year        Int
  month       Int
  branch      Branch   @default(JHB)
  submittedBy String   @map("submitted_by")
  submittedAt DateTime @default(now()) @map("submitted_at")
  user        User     @relation(fields: [submittedBy], references: [id])

  @@unique([year, month, branch])
  @@index([year, month])
  @@index([branch])
  @@map("submissions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?    @map("details")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ModelPart {
  id            String      @id @default(uuid())
  modelId       String      @map("model_id")
  partName      String      @map("part_name")
  itemCode      String?     @map("item_code")
  partType      PartType    @default(general) @map("part_type")
  tonerColor    TonerColor? @map("toner_color")
  expectedYield Int         @map("expected_yield")
  costRand      Decimal     @map("cost_rand") @db.Decimal(12, 2)
  meterType     MeterType   @default(mono) @map("meter_type")
  branch        Branch      @default(JHB)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  model        Model             @relation(fields: [modelId], references: [id], onDelete: Cascade)
  replacements PartReplacement[]

  @@unique([modelId, partName, branch])
  @@index([modelId])
  @@index([branch])
  @@map("model_parts")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  /// Tenant branch for this alert (nullable until legacy rows are backfilled).
  branch     Branch?   @map("branch")
  type       String    @map("type")
  title      String    @map("title")
  message    String?   @map("message")
  linkUrl    String?   @map("link_url")
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, branch])
  @@index([createdAt])
  @@index([readAt])
  @@map("notifications")
}

model PartReplacement {
  id                      String   @id @default(uuid())
  machineId               String   @map("machine_id")
  modelPartId             String   @map("model_part_id")
  orderDate               DateTime @map("order_date")
  priorReading            Int      @map("prior_reading")
  currentReading          Int      @map("current_reading")
  usage                   Int      @map("usage")
  remainingTonerPercent   Float?   @map("remaining_toner_percent")
  yieldMet                Boolean  @map("yield_met")
  shortfallClicks         Int      @default(0) @map("shortfall_clicks")
  adjustedShortfallClicks Int      @default(0) @map("adjusted_shortfall_clicks")
  costPerClick            Decimal  @map("cost_per_click") @db.Decimal(10, 4)
  displayChargeRand       Decimal  @map("display_charge_rand") @db.Decimal(12, 2)
  expectedYieldSnapshot   Int      @map("expected_yield_snapshot")
  costRandSnapshot        Decimal  @map("cost_rand_snapshot") @db.Decimal(12, 2)
  branch                  Branch   @default(JHB)
  capturedBy              String   @map("captured_by")
  capturedAt              DateTime @default(now()) @map("captured_at")

  machine   Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  modelPart ModelPart @relation(fields: [modelPartId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [capturedBy], references: [id])

  @@index([machineId])
  @@index([modelPartId])
  @@index([orderDate])
  @@index([branch])
  @@map("part_replacements")
}

// --- Connectivity Monitoring Module ---

enum MonitoringStatus {
  enabled
  disabled
}

enum ConnectivityServiceType {
  fibre
  wireless
  lte
  other
}

enum LinkStatus {
  up
  down
  partial
  dns_failure
}

enum AlertDeliveryStatus {
  pending
  sent
  failed
}

model MonitoringTarget {
  id                        String                  @id @default(uuid())
  branch                    Branch                  @default(JHB) @map("branch")
  customerName              String                  @map("customer_name")
  siteName                  String                  @map("site_name")
  monitoringTarget          String                  @map("monitoring_target")
  supplier                  String?                 @map("supplier")
  circuitNumber             String?                 @map("circuit_number")
  fno                       String?                 @map("fno")
  serviceType               ConnectivityServiceType @default(other) @map("service_type")
  notes                     String?                 @map("notes")
  alertEmail                String?                 @map("alert_email")
  contactPersonName         String?                 @map("contact_person_name")
  contactPersonPhone        String?                 @map("contact_person_phone")
  status                    MonitoringStatus        @default(enabled) @map("status")
  resolvedIp                String?                 @map("resolved_ip")
  dnsRefreshIntervalMinutes Int                     @default(5) @map("dns_refresh_interval_minutes")
  lastCheckAt               DateTime?               @map("last_check_at")
  currentStatus             LinkStatus?             @map("current_status")
  currentLatencyMs          Float?                  @map("current_latency_ms")
  currentPacketLossPercent  Float?                  @map("current_packet_loss_percent")
  consecutiveFailures       Int                     @default(0) @map("consecutive_failures")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")

  checkResults     MonitoringCheckResult[]
  alertTimeWindows AlertTimeWindow[]
  outageLogs       OutageLog[]
  alertLogs        AlertLog[]

  @@index([status])
  @@index([currentStatus])
  @@index([branch])
  @@map("monitoring_targets")
}

model MonitoringCheckResult {
  id                 String     @id @default(uuid())
  targetId           String     @map("target_id")
  status             LinkStatus @map("status")
  latencyMs          Float?     @map("latency_ms")
  packetLossPercent  Float      @default(0) @map("packet_loss_percent")
  lastSuccessfulPing DateTime?  @map("last_successful_ping")
  checkedAt          DateTime   @default(now()) @map("checked_at")
  nodeId             String?    @map("node_id")

  target MonitoringTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@index([checkedAt])
  @@map("monitoring_check_results")
}

model MonitoringNode {
  id         String    @id @default(uuid())
  name       String    @map("name")
  apiKeyHash String    @map("api_key_hash")
  enabled    Boolean   @default(true) @map("enabled")
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("monitoring_nodes")
}

model AlertTimeWindow {
  id         String   @id @default(uuid())
  targetId   String?  @map("target_id")
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  daysOfWeek Json     @map("days_of_week")
  enabled    Boolean  @default(true) @map("enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  target MonitoringTarget? @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@map("alert_time_windows")
}

model OutageLog {
  id              String    @id @default(uuid())
  targetId        String    @map("target_id")
  startedAt       DateTime  @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")
  statusAtEnd     String?   @map("status_at_end")
  note            String?   @map("note")
  createdAt       DateTime  @default(now()) @map("created_at")

  target MonitoringTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@index([startedAt])
  @@map("outage_logs")
}

model AlertLog {
  id             String              @id @default(uuid())
  targetId       String              @map("target_id")
  alertType      String              @map("alert_type")
  sentAt         DateTime            @default(now()) @map("sent_at")
  deliveryStatus AlertDeliveryStatus @default(pending) @map("delivery_status")
  recipientEmail String              @map("recipient_email")
  createdAt      DateTime            @default(now()) @map("created_at")

  target MonitoringTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@index([sentAt])
  @@map("alert_logs")
}

model SlaTarget {
  id            String                  @id @default(uuid())
  serviceType   ConnectivityServiceType @unique @map("service_type")
  targetPercent Float                   @map("target_percent")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@map("sla_targets")
}
model BillingRun {
  id            String           @id @default(uuid())
  branch        String           @map("branch")
  period        String           @map("period")          // e.g. "2026-05"
  processedBy   String           @map("processed_by")    // display name, no FK
  notes         String?          @map("notes")
  totalMobile   Float            @default(0) @map("total_mobile")
  totalIntl     Float            @default(0) @map("total_intl")
  totalNational Float            @default(0) @map("total_national")
  totalLocal    Float            @default(0) @map("total_local")
  totalSpecial  Float            @default(0) @map("total_special")
  totalVirtual  Float            @default(0) @map("total_virtual")
  totalVce      Float            @default(0) @map("total_vce")
  grandTotal    Float            @default(0) @map("grand_total")
  clientCount   Int              @default(0) @map("client_count")
  createdAt     DateTime         @default(now()) @map("created_at")

  lines         BillingRunLine[]

  @@index([branch])
  @@index([period])
  @@index([createdAt])
  @@map("billing_runs")
}

model BillingRunLine {
  id            String     @id @default(uuid())
  billingRunId  String     @map("billing_run_id")
  clientCode    String     @map("client_code")
  customerName  String     @map("customer_name")
  category      String     @default("") @map("category")
  mobile        Float      @default(0) @map("mobile")
  international Float      @default(0) @map("international")
  national      Float      @default(0) @map("national")
  local         Float      @default(0) @map("local")
  special       Float      @default(0) @map("special")
  virtual       Float      @default(0) @map("virtual")
  vce           Float      @default(0) @map("vce")
  lineTotal     Float      @default(0) @map("line_total")
  lineType      String     @default("billed") @map("line_type") // billed | excluded | unmatched | noActivity
  confirmed     Boolean    @default(false) @map("confirmed")

  run           BillingRun @relation(fields: [billingRunId], references: [id], onDelete: Cascade)

  @@index([billingRunId])
  @@index([clientCode])
  @@index([billingRunId, lineType])
  @@map("billing_run_lines")
}

model Engine3Lookup {
  id            String   @id @default(uuid())
  branch        String   @map("branch")
  customerName  String   @map("customer_name")
  smartEdgeCode String   @default("") @map("smart_edge_code")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([branch, customerName])
  @@index([branch])
  @@map("engine3_lookup")
}

model FinanceExclusion {
  id        String   @id @default(uuid())
  branch    String   @map("branch")
  type      String   @map("type")    // "category" or "code"
  value     String   @map("value")   // e.g. "Data" or "ACC0101"
  note      String?  @map("note")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([branch, type, value])
  @@index([branch])
  @@map("finance_exclusions")
}
